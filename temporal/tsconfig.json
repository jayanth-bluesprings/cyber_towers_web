{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "commonjs",
    "lib":             ["ES2020"],
    "outDir":          "./lib",
    "rootDir":         "./src",
    "strict":          true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "sourceMap":       true,
    "declaration":     true,
    "skipLibCheck":    true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"]
}
