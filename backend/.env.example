# ─────────────────────────────────────────────────────────────────────────────
# CyberTowers Vehicle Access Dashboard — Backend environment
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production. In production the server refuses to start if any
# security-critical variable below is missing or weak (see config.js).
NODE_ENV=development
PORT=5000

# ── Security ──────────────────────────────────────────────────────────────────
# Long random secret required for all /api routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-a-long-random-secret

# Comma-separated allowed CORS origins. Must NOT be "*" in production.
ALLOWED_ORIGINS=http://localhost:3000,https://access.yourdomain.com

# AES-256 key (>= 32 chars) used to encrypt controller passwords at rest.
# Required in production. Generate with the same command as API_KEY.
BRIDGE_ENCRYPTION_KEY=replace-with-a-32char-min-encryption-key

# Set to true when running behind nginx / IIS / a load balancer so that
# client IPs and rate limiting work correctly.
TRUST_PROXY=false

# ── Rate limiting (browser-facing /api routes only) ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Max accepted request body size.
JSON_BODY_LIMIT=1mb

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=cybertowers_access
PG_USER=postgres
PG_PASSWORD=yourpassword
PG_POOL_MAX=20
PG_POOL_MIN=2
PG_IDLE_MS=30000

# ── Email / SMTP (automated reports & alerts) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CyberTowers Access <noreply@yourdomain.com>

# ── Temporal (optional — workflow engine) ────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
